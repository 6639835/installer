{
  "compilerOptions": {
    "allowJs": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM"],
    "target": "ES6",
    "paths": {
      "*": ["node_modules/*"],
      "common/*": ["./src/common/*"],
      "renderer/*": ["./src/renderer/*"],
      "@flybywiresim/fragmenter": ["./src/renderer/platform/fragmenterCompat.ts"],
      "fs": ["./src/renderer/platform/node/fs.ts"],
      "os": ["./src/renderer/platform/node/os.ts"],
      "path": ["./src/renderer/platform/node/path.ts"]
    },
    "jsx": "react"
  },
  "include": [
    "src/**/*"
  ]
}
