{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlyByWire Installer",
  "version": "3.7.1-dev.1",
  "identifier": "org.flybywiresim.installer",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FlyByWire Installer",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "decorations": false,
        "backgroundColor": "#1b2434",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["resources/*"],
    "category": "Utility",
    "shortDescription": "Install and customize FlyByWire addons",
    "longDescription": "Desktop application to install and customize FlyByWire addons",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
